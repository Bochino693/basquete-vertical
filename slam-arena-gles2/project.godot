; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Slam Arena"
config/description="Slam Arena - basquete arcade vertical (Lazer & Sport) - edicao OpenGL ES 2.0"
run/main_scene="res://cenas/principal.tscn"
boot_splash/image="res://imagens/splash.png"
boot_splash/bg_color=Color( 0.024, 0.016, 0.047, 1 )
config/icon="res://imagens/icone.png"
config/quit_on_go_back=false

[autoload]

Ajustes="*res://autoload/Ajustes.gd"
Tela="*res://autoload/Tela.gd"
Arte="*res://autoload/Arte.gd"
Sons="*res://autoload/Sons.gd"
Controles="*res://autoload/Controles.gd"
Arduino="*res://autoload/Arduino.gd"

[display]

window/size/width=1080
window/size/height=1920
window/size/fullscreen=true
window/handheld/orientation="sensor_landscape"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_fps=30

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=0
vram_compression/import_etc=true
vram_compression/import_etc2=false
gles2/compatibility/disable_half_float=true
environment/default_clear_color=Color( 0.016, 0.01, 0.028, 1 )

[slam]

tela/giro=1
